# Solapi (알림톡/문자 발송)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=01090080851
SOLAPI_PFID=KA01PF260409120809915UFtRoM8Y2O1

# 알림톡 발송 API 전용 토큰 — index.html의 API_AUTH_TOKEN 상수와 반드시 동일한 값으로 설정
# 앱 로그인 아이디/비밀번호와는 무관하며, 한 번 설정하면 관리자 아이디/비밀번호를 바꿔도 다시 맞출 필요 없음
API_AUTH_TOKEN=

# 웹 푸시 (기존 기능, 이미 사용 중이면 기존 값 유지)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@oheng.vercel.app

# Upstash Redis (기존 기능, 이미 사용 중이면 기존 값 유지)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
